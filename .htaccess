# Apache: impede listagem de diretórios e bloqueia acesso a arquivos sensíveis
Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|sql|md)$">
    Require all denied
</FilesMatch>

# Protege pastas internas de acesso direto via URL
RewriteEngine On
RewriteRule ^(config|includes|database|tests|scripts|storage)/ - [F,L]

# Headers de segurança (complementar ao PHP)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
